# Copy to .env and fill in. These are PUBLIC client values — safe to ship.
# Row-Level Security protects data; the Anthropic key lives only in the Edge Function.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Deep link Supabase sends users back to after a confirmation or reset email.
# Must be listed under Auth → URL configuration → Redirect URLs.
AUTH_REDIRECT_URL=dollchecker://auth-callback

# Published legal pages and support address. Leave blank until they exist —
# the app hides the rows rather than linking nowhere. Required before release.
PRIVACY_URL=
TERMS_URL=
SUPPORT_EMAIL=

# Optional price line on the paywall. The checkout page is the authority on
# price — leave blank rather than let this go stale.
PREMIUM_PRICE_LABEL=
