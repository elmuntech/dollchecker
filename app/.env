# Fill these in. Both are PUBLIC client values (safe to ship); RLS protects data.
# The Anthropic key is NOT here — it lives only in the Supabase Edge Function secrets.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Deep link Supabase sends users back to after a confirmation or reset email.
AUTH_REDIRECT_URL=dollchecker://auth-callback

# Published legal pages and support address (blank = row hidden in the app).
PRIVACY_URL=
TERMS_URL=
SUPPORT_EMAIL=

# Optional price line on the paywall (blank = no price shown).
PREMIUM_PRICE_LABEL=
