# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/pubspec.lock
**/*.g.dart
**/*.freezed.dart
app/lib/l10n/app_localizations*.dart

# Env / secrets
# NOTE: app/.env holds only PUBLIC client values (Supabase URL + anon key) and is
# intentionally tracked so the app builds after clone. Real secrets never go here.
.env.local
**/.env.local
*.pem
supabase/.env

# Supabase
supabase/.branches/
supabase/.temp/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Node (tooling only)
node_modules/
