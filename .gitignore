# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
# NOTE: app/pubspec.lock is deliberately NOT ignored. DollChecker is an
# application, not a library: the whole point of a lockfile is that the build
# that ships is the build that was tested. Leaving it untracked has already
# cost us once — a dependency resolved differently between two CI runs and
# broke the build with an argument that had been removed in a major version.
**/*.g.dart
**/*.freezed.dart
app/lib/l10n/app_localizations*.dart

# Generated platform projects — recreated by `flutter create` and configured by
# tool/configure_platform.py, so they are never committed and never drift.
app/android/
app/ios/
app/linux/
app/macos/
app/windows/
app/web/

# Signing material. Losing the upload key means never updating the app again,
# so it is backed up out of band — but it must never be in the repository.
*.jks
*.keystore
**/key.properties

# Env / secrets
# NOTE: app/.env holds only PUBLIC client values (Supabase URL + anon key) and is
# intentionally tracked so the app builds after clone. Real secrets never go here.
.env.local
**/.env.local
*.pem
supabase/.env

# Supabase
supabase/.branches/
supabase/.temp/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Node (tooling only)
node_modules/
